<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BiliCopilot.UI.Controls.Local">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/AppTitleBar.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/ImageExBase.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/CardControl.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/DraggableCardControl.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/SettingsCard.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/SettingsExpander.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/AppToggleCard.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/CustomNavigationViewResources.xaml" />
        <ResourceDictionary Source="ms-appx:///Controls/Local/Themes/AILogo.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityReverseConverter" IsReverse="True" />
    <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
    <converters:ObjectToBoolConverter x:Key="ObjectToBoolReverseConverter" IsReverse="True" />
    <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter" />
    <converters:ObjectToVisibilityConverter x:Key="ObjectToVisibilityReverseConverter" IsReverse="True" />
    <converters:BoolToIconVariantConverter x:Key="BoolToIconVariantConverter" />
</ResourceDictionary>
